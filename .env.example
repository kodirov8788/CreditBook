# Supabase Public Keys (Browser & SSR)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-key
NEXT_PUBLIC_APP_URL=https://your-production-domain.vercel.app

# Supabase Server Keys (Server-only / Edge)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
SUPABASE_SECRET_KEY=sb_secret_your-key
SUPABASE_JWKS_URL=https://your-project-id.supabase.co/auth/v1/.well-known/jwks.json

# Supabase Database Direct Credentials
SUPABASE_DATABASE_PASSWORD=your-database-password
DATABASE_URL=postgresql://postgres.[project-id]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres:[password]@db.[project-id].supabase.co:5432/postgres
